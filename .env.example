# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# LLM_MODEL=gpt-4o-mini            # tagging and reranking
# ANSWER_MODEL=gpt-4o-mini         # final answers
# EMBEDDING_MODEL=text-embedding-3-small

# HTTP API: clients send this as the X-API-Key header. Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
API_KEY=
# RATE_LIMIT_PER_MINUTE=10         # per client IP
# DAILY_REQUEST_LIMIT=200          # all clients together
