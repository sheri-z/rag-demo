                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('kind name', () => pm.expect(body.kind).to.eql('name'));",
                  "pm.test('source knowledge_base', () => pm.expect(body.source).to.eql('knowledge_base'));",
                  "pm.test('answer matches the report', () => pm.expect(String(a).includes('Fandozzi')).to.be.true);"
                ]
              }
