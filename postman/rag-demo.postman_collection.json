        {
          "name": "Microsoft CEO (web fallback)",
          "request": {
            "description": "Expected: Not in the knowledge base, answered by web search over MCP. The answer type is detected automatically (expected: name).",
            "method": "POST",
            "url": "{{base_url}}/ask",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Who is the CEO of Microsoft?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const a = body.answer;",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('kind name', () => pm.expect(body.kind).to.eql('name'));",
                  "pm.test('source web', () => pm.expect(body.source).to.eql('web'));",
                  "pm.test('answer matches the report', () => pm.expect(String(a).includes('Nadella')).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
